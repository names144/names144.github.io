---
import { Picture } from "astro:assets";
import { Icon } from "astro-icon/components";
import SocialIcon from "./SocialIcon.astro";

import headerImage from "../assets/me.jpg";
---

<header
  class="flex flex-col-reverse sm:flex-row gap-8 sm:gap-12 sm:items-start"
>
  <div class="flex flex-col gap-5 animate-rise-in">
    <div class="flex flex-col gap-2">
      <p
        class="font-mono text-xs sm:text-sm tracking-[0.2em] uppercase text-accent-deep dark:text-accent"
      >
        Staff Software Engineer
      </p>
      <h1
        class="font-display text-4xl sm:text-5xl font-medium tracking-tight text-balance"
      >
        Nicholas Ames
      </h1>
      <p
        class="flex items-center gap-1.5 font-mono text-sm text-muted-light dark:text-muted-dark"
      >
        <Icon
          name="ri:map-pin-line"
          class="w-4 h-4 shrink-0"
          aria-hidden="true"
        />
        Seattle, WA
      </p>
    </div>
    <p
      class="text-base sm:text-lg leading-relaxed text-muted-light dark:text-muted-dark max-w-prose"
    >
      <slot />
    </p>
    <div class="flex flex-wrap gap-3 pt-1">
      <SocialIcon social="linkedin" />
      <SocialIcon social="github" />
    </div>
  </div>
  <div
    class="shrink-0 mx-auto sm:mx-0 animate-rise-in"
    style="animation-delay: 0.12s"
  >
    <div class="relative w-32 h-32 sm:w-40 sm:h-40">
      <div
        class="absolute -inset-1 rounded-full bg-linear-to-br from-accent to-transparent opacity-70"
        aria-hidden="true"
      >
      </div>
      <Picture
        sizes="(max-width: 640px) 128px, 160px"
        widths={[128, 160, 320]}
        class="relative rounded-full w-32 h-32 sm:w-40 sm:h-40 object-cover border-2 border-paper dark:border-ink"
        src={headerImage}
        alt="Nicholas Ames"
      />
    </div>
  </div>
</header>
