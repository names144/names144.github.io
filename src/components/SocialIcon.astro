---
import { Icon } from "astro-icon/components";

type Social = "github" | "linkedin";

interface Props {
  social: Social;
  class?: string;
}

const SOCIAL_META = {
  github: {
    href: "https://github.com/names144",
    icon: "ri:github-fill",
    label: "names144",
    title: "GitHub",
  },
  linkedin: {
    href: "https://www.linkedin.com/in/names144",
    icon: "ri:linkedin-fill",
    label: "names144",
    title: "LinkedIn",
  },
};

const { social, class: className, ...rest } = Astro.props;
const { icon, href, label, title } = SOCIAL_META[social];
---

<a
  class:list={[
    "group inline-flex items-center gap-2 rounded-full border border-line-light dark:border-line-dark px-3.5 py-1.5 font-mono text-sm transition-colors hover:border-accent hover:text-accent-deep dark:hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
    className,
  ]}
  title={title}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  {...rest}
>
  <Icon
    aria-hidden="true"
    focusable="false"
    name={icon}
    class="w-4 h-4 shrink-0"
  />
  <span>{label}</span>
</a>
