---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section
  class="flex flex-col gap-6 pt-10 border-t border-line-light dark:border-line-dark"
>
  <h2
    class="font-display text-xs sm:text-sm font-medium tracking-[0.25em] uppercase text-accent-deep dark:text-accent"
  >
    {title}
  </h2>
  <slot />
</section>
